# Environment & Demo Mode
ENVIRONMENT=development
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000

# SQLite Storage
DATABASE_URL="sqlite:///./data/rag.db"

# LLM Provider Configuration (Server-side only; never expose keys to frontend)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30.0

# OIDC / Keycloak Authentication
OIDC_ISSUER_URL=http://localhost:8080/realms/rag-realm
OIDC_CLIENT_ID=rag-engine
OIDC_AUDIENCE=rag-engine
JWT_SECRET=

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
